{
  "name": "@stockwise/monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"pnpm --filter @stockwise/backend dev\" \"pnpm --filter @stockwise/frontend dev\"",
    "dev:backend": "pnpm --filter @stockwise/backend dev",
    "dev:frontend": "pnpm --filter @stockwise/frontend dev",
    "build": "pnpm --filter @stockwise/shared build && pnpm --filter @stockwise/backend build && pnpm --filter @stockwise/frontend build",
    "lint": "pnpm -r --parallel lint",
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "vitest run",
    "test:integration": "vitest run -c vitest.config.integration.ts",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate --schema=prisma/schema.prisma",
    "db:push": "prisma db push --schema=prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema=prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema=prisma/schema.prisma",
    "db:seed": "tsx prisma/seed/seed.ts",
    "db:reconcile": "tsx prisma/reconcile.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "argon2": "^0.45.2"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "prisma": "^6.4.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  },
  "packageManager": "pnpm@12.16.1"
}
