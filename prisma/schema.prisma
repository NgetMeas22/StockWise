generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RecordStatus {
  ACTIVE
  ARCHIVED
}

enum SupplierStatus {
  ACTIVE
  INACTIVE
}

enum UnitOfMeasure {
  EACH
  BOX
  PACK
  KG
  G
  L
  ML
  M
}

enum MovementType {
  RECEIPT
  ISSUE
  ADJUSTMENT
  TRANSFER_OUT
  TRANSFER_IN
  REVERSAL
}

enum ReasonCode {
  PURCHASE_RECEIPT
  DIRECT_PURCHASE
  CUSTOMER_RETURN
  USAGE
  SUPPLIER_RETURN
  DAMAGED
  COUNT_CORRECTION
  TRANSFER
  REVERSAL
  OTHER
}

enum ReferenceType {
  PURCHASE_ORDER
  GOODS_RECEIPT
  TRANSFER
  MOVEMENT
  MANUAL
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

model User {
  id                 String    @id @default(uuid())
  email              String    @unique
  fullName           String    @map("full_name")
  passwordHash       String    @map("password_hash")
  isActive           Boolean   @default(true) @map("is_active")
  mustChangePassword Boolean   @default(true) @map("must_change_password")
  failedLoginCount   Int       @default(0) @map("failed_login_count")
  lockedUntil        DateTime? @map("locked_until")
  lastLoginAt        DateTime? @map("last_login_at")
  passwordChangedAt  DateTime? @map("password_changed_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  userRole           UserRole?
  sessions           Session[]
  auditLogs          AuditLog[]
  stockMovements     StockMovement[]
  createdPOs         PurchaseOrder[]  @relation("POCreator")
  orderedPOs         PurchaseOrder[]  @relation("POOrderer")
  cancelledPOs       PurchaseOrder[]  @relation("POCanceller")
  goodsReceipts      GoodsReceipt[]

  @@map("users")
}

model Role {
  id              String           @id @default(uuid())
  key             String           @unique
  name            String
  description     String?
  isSystem        Boolean          @default(true) @map("is_system")

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id              String           @id @default(uuid())
  key             String           @unique
  groupName       String           @map("group_name")
  description     String

  rolePermissions RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId    String   @id @map("user_id")
  roleId    String   @map("role_id")
  grantedBy String?  @map("granted_by")
  grantedAt DateTime @default(now()) @map("granted_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@map("user_roles")
}

model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Session {
  id                 String    @id @default(uuid())
  userId             String    @map("user_id")
  tokenHash          String    @unique @map("token_hash")
  csrfHash           String    @map("csrf_hash")
  createdAt          DateTime  @default(now()) @map("created_at")
  lastSeenAt         DateTime  @default(now()) @map("last_seen_at")
  idleExpiresAt      DateTime  @map("idle_expires_at")
  absoluteExpiresAt  DateTime  @map("absolute_expires_at")
  revokedAt          DateTime? @map("revoked_at")
  revokedReason      String?   @map("revoked_reason")
  ip                 String?
  userAgent          String?   @map("user_agent")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([idleExpiresAt])
  @@map("sessions")
}

model Category {
  id          String       @id @default(uuid())
  parentId    String?      @map("parent_id")
  name        String
  slug        String       @unique
  description String?
  imageKey    String?      @map("image_key")
  sortOrder   Int          @default(0) @map("sort_order")
  status      RecordStatus @default(ACTIVE)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryHierarchy")
  products Product[]

  @@map("categories")
}

model Product {
  id                String        @id @default(uuid())
  sku               String        @unique
  barcode           String?
  barcodeNormalized String?       @map("barcode_normalized")
  name              String
  slug              String        @unique
  description       String?
  brand             String?
  imageKey          String?       @map("image_key")
  unit              UnitOfMeasure @default(EACH)
  costPrice         Decimal       @default(0) @map("cost_price") @db.Decimal(14, 4)
  averageCost       Decimal       @default(0) @map("average_cost") @db.Decimal(14, 4)
  sellingPrice      Decimal       @default(0) @map("selling_price") @db.Decimal(14, 2)
  categoryId        String        @map("category_id")
  reorderLevel      Decimal       @default(0) @map("reorder_level") @db.Decimal(14, 3)
  status            RecordStatus  @default(ACTIVE)
  isPublished       Boolean       @default(false) @map("is_published")
  archivedAt        DateTime?     @map("archived_at")
  version           Int           @default(1)
  createdBy         String?       @map("created_by")
  updatedBy         String?       @map("updated_by")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  category          Category           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  inventoryBalances InventoryBalance[]
  stockMovements    StockMovement[]
  poItems           PurchaseOrderItem[]
  receiptItems      GoodsReceiptItem[]

  @@index([categoryId, status])
  @@index([status, isPublished])
  @@map("products")
}

model Warehouse {
  id        String       @id @default(uuid())
  code      String       @unique
  name      String
  address   String?
  isDefault Boolean      @default(false) @map("is_default")
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  inventoryBalances InventoryBalance[]
  stockMovements    StockMovement[]
  purchaseOrders    PurchaseOrder[]
  goodsReceipts     GoodsReceipt[]

  @@map("warehouses")
}

model Supplier {
  id            String         @id @default(uuid())
  name          String         @unique
  contactPerson String?        @map("contact_person")
  email         String?
  phone         String?
  address       String?
  notes         String?
  status        SupplierStatus @default(ACTIVE)
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  purchaseOrders PurchaseOrder[]

  @@map("suppliers")
}

model InventoryBalance {
  productId      String   @map("product_id")
  warehouseId    String   @map("warehouse_id")
  quantityOnHand Decimal  @default(0) @map("quantity_on_hand") @db.Decimal(14, 3)
  updatedAt      DateTime @updatedAt @map("updated_at")

  product   Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  @@id([productId, warehouseId])
  @@index([warehouseId])
  @@map("inventory_balances")
}

model StockMovement {
  id                  String        @id @default(uuid())
  seq                 BigInt        @default(autoincrement())
  productId           String        @map("product_id")
  warehouseId         String        @map("warehouse_id")
  movementType        MovementType  @map("movement_type")
  quantityDelta       Decimal       @map("quantity_delta") @db.Decimal(14, 3)
  quantityAfter       Decimal       @map("quantity_after") @db.Decimal(14, 3)
  unitCost            Decimal?      @map("unit_cost") @db.Decimal(14, 4)
  reasonCode          ReasonCode    @map("reason_code")
  reason              String
  referenceType       ReferenceType @default(MANUAL) @map("reference_type")
  referenceId         String?       @map("reference_id")
  transferGroupId     String?       @map("transfer_group_id")
  reversesMovementId  String?       @unique @map("reverses_movement_id")
  idempotencyKey      String?       @map("idempotency_key")
  performedBy         String        @map("performed_by")
  createdAt           DateTime      @default(now()) @map("created_at")

  product            Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse          Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  performer          User           @relation(fields: [performedBy], references: [id], onDelete: Restrict)
  reverses           StockMovement? @relation("MovementReversal", fields: [reversesMovementId], references: [id], onDelete: Restrict)
  reversedBy         StockMovement? @relation("MovementReversal")
  goodsReceiptItem   GoodsReceiptItem?

  @@index([productId, seq(sort: Desc)])
  @@index([warehouseId, seq(sort: Desc)])
  @@index([performedBy, createdAt])
  @@index([createdAt])
  @@index([referenceType, referenceId])
  @@map("stock_movements")
}

model PurchaseOrder {
  id           String              @id @default(uuid())
  poNumber     String              @unique @map("po_number")
  supplierId   String              @map("supplier_id")
  warehouseId  String              @map("warehouse_id")
  status       PurchaseOrderStatus @default(DRAFT)
  orderDate    DateTime            @default(now()) @map("order_date")
  expectedDate DateTime?           @map("expected_date")
  notes        String?
  createdBy    String              @map("created_by")
  orderedBy    String?             @map("ordered_by")
  orderedAt    DateTime?           @map("ordered_at")
  cancelledBy  String?             @map("cancelled_by")
  cancelledAt  DateTime?           @map("cancelled_at")
  cancelReason String?             @map("cancel_reason")
  version      Int                 @default(1)
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")

  supplier     Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  warehouse    Warehouse           @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  creator      User                @relation("POCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  orderer      User?               @relation("POOrderer", fields: [orderedBy], references: [id], onDelete: Restrict)
  canceller    User?               @relation("POCanceller", fields: [cancelledBy], references: [id], onDelete: Restrict)
  items        PurchaseOrderItem[]
  goodsReceipts GoodsReceipt[]

  @@index([status, createdAt])
  @@index([supplierId, createdAt])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id               String   @id @default(uuid())
  purchaseOrderId  String   @map("purchase_order_id")
  productId        String   @map("product_id")
  lineNumber       Int      @map("line_number")
  quantityOrdered  Decimal  @map("quantity_ordered") @db.Decimal(14, 3)
  quantityReceived Decimal  @default(0) @map("quantity_received") @db.Decimal(14, 3)
  unitCost         Decimal  @map("unit_cost") @db.Decimal(14, 4)

  purchaseOrder     PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product           Product            @relation(fields: [productId], references: [id], onDelete: Restrict)
  goodsReceiptItems GoodsReceiptItem[]

  @@unique([purchaseOrderId, productId])
  @@map("purchase_order_items")
}

model GoodsReceipt {
  id              String   @id @default(uuid())
  receiptNumber   String   @unique @map("receipt_number")
  purchaseOrderId String   @map("purchase_order_id")
  warehouseId     String   @map("warehouse_id")
  receivedBy      String   @map("received_by")
  receivedAt      DateTime @default(now()) @map("received_at")
  deliveryNoteRef String?  @map("delivery_note_ref")
  notes           String?
  createdAt       DateTime @default(now()) @map("created_at")

  purchaseOrder PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  warehouse     Warehouse          @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  receiver      User               @relation(fields: [receivedBy], references: [id], onDelete: Restrict)
  items         GoodsReceiptItem[]

  @@index([purchaseOrderId])
  @@map("goods_receipts")
}

model GoodsReceiptItem {
  id                  String  @id @default(uuid())
  goodsReceiptId      String  @map("goods_receipt_id")
  purchaseOrderItemId String  @map("purchase_order_item_id")
  productId           String  @map("product_id")
  quantityReceived    Decimal @map("quantity_received") @db.Decimal(14, 3)
  unitCost            Decimal @map("unit_cost") @db.Decimal(14, 4)
  stockMovementId     String  @unique @map("stock_movement_id")

  goodsReceipt      GoodsReceipt      @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  purchaseOrderItem PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id], onDelete: Restrict)
  product           Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  stockMovement     StockMovement     @relation(fields: [stockMovementId], references: [id], onDelete: Restrict)

  @@map("goods_receipt_items")
}

model AuditLog {
  id          String   @id @default(uuid())
  seq         BigInt   @default(autoincrement())
  actorUserId String?  @map("actor_user_id")
  action      String
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id")
  before      Json?
  after       Json?
  ip          String?
  userAgent   String?  @map("user_agent")
  requestId   String?  @map("request_id")
  createdAt   DateTime @default(now()) @map("created_at")

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

model AppSetting {
  key       String   @id
  value     Json
  updatedBy String?  @map("updated_by")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}

model DocumentCounter {
  scope     String
  year      Int
  lastValue Int    @default(0) @map("last_value")

  @@id([scope, year])
  @@map("document_counters")
}

