NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Database connection strings (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/stockwise
DATABASE_MIGRATION_URL=postgresql://postgres:postgres@localhost:5432/stockwise

# Web application origin for CORS & CSRF Origin checks
WEB_ORIGIN=http://localhost:3000

# Proxy trust count
TRUST_PROXY=0

# Session lifetime in minutes (idle) and hours (absolute)
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12

# CSRF HMAC Secret (minimum 32 characters)
CSRF_SECRET=change_this_to_a_random_32_character_string_for_csrf

# File upload configuration
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5

# Initial Admin Seeding Credentials (only used during db:seed)
SEED_ADMIN_EMAIL=admin@stockwise.local
SEED_ADMIN_PASSWORD=AdminPassword123!

